# Rust build output
/target/

# Toolkit run output (decompile writes here by default)
arlecchino_out/
arlecchino_out_*/
*_out/

# FreeJ2ME writes runtime state in the cwd when `emulate` runs
config/
freej2me_system/
rms/

# user-specific local config
arlecchino.local.toml

# javac writes an @argfile into its cwd when the command line gets too long.
# We now hand javac the output directory (util::run_capture_in), so these land
# inside the output tree, not here — this rule only catches strays from older
# binaries and from running javac by hand.
javac.*.args

# Private corpus overlay for the regression gate (see regress/expected.txt)
regress/expected.local.txt
